{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "http://example.com/example.json",
    "type": "object",
    "default": {},
    "title": "Root Schema",
    "properties": {
        "status": {
            "type": "string",
            "enum": [
                "Pending",
                "Delivered",
                "Failed"
            ],
            "default": "Pending",
            "title": "The status Schema",
            "examples": [
                "Available"
            ]
        }
    },
    "examples": [{
        "title": "title",
        "description": "description",
        "categoryId": 1,
        "conditionId": 1,
        "locationId": 1
    }],
    "required": ["status"],
    "additionalProperties": false
}
