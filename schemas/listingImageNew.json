{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "http://example.com/example.json",
    "type": "object",
    "default": {},
    "title": "Root Schema",
    "properties": {
        "imageUrl": {
            "type": "string",
            "default": "",
            "title": "The image Schema",
            "pattern": "\\.(jpg|jpeg|png|gif|bmp|webp)$",
            "examples": [
                "1.jpg"
            ]
        }
    },
    "required": [
        "imageUrl"
    ],
    "examples": [{
        "image": "1.jpg"
    }],
    "additionalProperties": false
}