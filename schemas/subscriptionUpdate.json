{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "http://example.com/example.json",
    "type": "object",
    "default": {},
    "title": "Root Schema",
    "properties": {
      "status": {
        "type": "boolean"
      },
      "browserToken": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": ["status"],
    "additionalProperties": false
  }
  